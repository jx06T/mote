{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "mote-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENV": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mote-db",
      "database_id": "48fdf066-f6d9-4b1d-8d09-885f6a4c3498"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "mote-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "local-kv"
    }
  ]
}